# Copy to .env.local and set this to your MQTT broker.
MQTT_URL=mqtt://localhost:1883
MQTT_MOTION_EVENTS_TOPIC=room-detector/motion-events
# Used only before the devkit has completed empty-room calibration.
# Calibrated from backend/data/empty.csv for study-room-2. Recalculate for a new room.
MOTION_BASELINE_DIFF_MEDIAN=0.348
MOTION_BASELINE_DIFF_TOLERANCE=0.074
# Optional. Omit to make one timestamped CSV capture per server run.
# MOTION_CSV_PATH=data/empty-room.csv
