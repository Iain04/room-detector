# Receiver firmware settings. Copy this file to .env and fill it in.
# Values here override menuconfig; leave a value empty to use menuconfig's.
# Rebuild and flash the receiver after changing this file.

# 2.4 GHz network only
WIFI_SSID=
WIFI_PASSWORD=

# Use the broker's LAN IP, not localhost, e.g. mqtt://192.168.1.50:1883
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
# Must match MQTT_MOTION_EVENTS_TOPIC in the backend's .env.local
MQTT_TELEMETRY_TOPIC=room-detector/motion-events
MQTT_USERNAME=
MQTT_PASSWORD=

ROOM_ID=study-room-2
DEVICE_ID=esp32-rx-01

# router = one ESP32 pinging your Wi-Fi router (default)
# sender = two ESP32s (a second board runs firmware/sender)
CSI_SOURCE=router

# Sender mode only. Printed by the sender at boot ("SENDER MAC: ..."). Empty = accept any sender.
SENDER_MAC=

SNTP_SERVER=pool.ntp.org
